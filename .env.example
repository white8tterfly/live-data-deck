# ===== B 站登录凭证（可选但强烈建议填写） =====
# getDanmuInfo 返回的 token 与登录身份绑定；未填写时走游客模式（uid=0，
# 部分边缘节点可能秒踢，稳定性不如登录模式）。
# 获取方式：浏览器登录 https://live.bilibili.com → F12 开发者工具
#          → Application（应用）→ Cookies → 复制 SESSDATA 的值
SESSDATA=

# ===== uid 哈希匿名化盐（可选） =====
# 录制文件默认不保存真实 uid（sha256 加盐截断），改盐会导致跨文件无法关联同一用户。
DANMAKU_ANON_SALT=
